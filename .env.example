# Polymarket / CLOB
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com

# Copy trading
TARGET_WALLETS=0xTargetWallet1,0xTargetWallet2
COPY_RATIO=0.25
MAX_POSITION_USD=250
MAX_DAILY_LOSS_USD=500
MIN_EDGE_BPS=50
MAX_COPY_LATENCY_MS=800
DRY_RUN=true

# Engine
POLL_INTERVAL_MS=250
MARKET_FILTER=weather
PAPER_STARTING_BALANCE=10000

# Observability (optional)
# ─ Sentry: get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

# Grafana (default admin/polymeteo — change in production)
GRAFANA_USER=admin
GRAFANA_PASSWORD=polymeteo

# n8n (default admin/polymeteo)
N8N_PASSWORD=polymeteo
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678

# Slack alerting (optional — create a Slack App with incoming-webhook permission)
SLACK_CHANNEL=#polymeteo-alerts
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Alert email (optional — Gmail OAuth2 or any SMTP)
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Cloudflare Tunnel (optional — expose Grafana without opening ports)
# 1. Create a free Cloudflare account
# 2. Run: cloudflared tunnel create polymeteo
# 3. Point to your Grafana service: cloudflared tunnel route dns polymeteo grafana.yourdomain.com
CLOUDFLARE_TUNNEL_TOKEN=

# Sentry self-hosted (optional — leave empty to use sentry.io)
SENTRY_DB_PASSWORD=sentry
SENTRY_SECRET_KEY=change-me-in-prod-use-pwgen-32
